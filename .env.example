# Bu dosyayı .env olarak kopyalayıp doldurun. .env git'e girmez.

# Claude API (senaryo, haber puanlama, doğrulama). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Opsiyonel: bulut seslendirme (tts.backend: elevenlabs | gemini). İkisinin de ücretsiz planı var.
# ElevenLabs: https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Opsiyonel: Hugging Face (kapılı modeller için, ör. kyutai tabanlı Pocket TTS sürümleri)
HF_TOKEN=
